# Plantilla de variables de entorno de SecureBank API (Sesión 7).
# Copiar a .env (que está en .gitignore) y reemplazar cada valor. NUNCA subir .env al repo.
# src/config.py rechaza valores vacíos, de ejemplo (changeme, password, secret...) y JWT_SECRET < 32 caracteres.

# Clave de firma de los JWT (HS256). Generar con: openssl rand -base64 48
JWT_SECRET=${JWT_SECRET}

# Vida del token en minutos (1-60). Opcional, por defecto 15.
JWT_TTL_MINUTES=15

# Cadena de conexión a la base de datos
DATABASE_URL=sqlite:///securebank.db

# Ruta del archivo SQLite que usa src/users/users.py
SECUREBANK_DB=securebank.db

# Solo laboratorio DAST (docker-compose.dast.yml): contraseñas de los usuarios semilla
SEED_ALICE_PW=${SEED_ALICE_PW}
SEED_BOB_PW=${SEED_BOB_PW}
